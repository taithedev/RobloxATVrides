-- ZuzuATV v0.3 one-paste Studio EDIT MODE Command Bar installer.
-- Physics uses the EXACT ATV_Package manifest wheel geometry.
-- AFTER this installer: import ATV.fbx and run ImportBlenderATV.server.luau.
local Workspace=game:GetService("Workspace")
local StarterPlayer=game:GetService("StarterPlayer")
local old=Workspace:FindFirstChild("ZuzuATV")
if old then old:Destroy() end -- BACK UP customized vehicles before re-running
local model=Instance.new("Model")
model.Name="ZuzuATV"
model.Parent=Workspace
model:SetAttribute("Version","0.3.0")
local rootCF=CFrame.new(0,6,0)
local function makePart(name,size,cf,color,anchored,canCollide,parent)
 local p=Instance.new("Part")
 p.Name=name
 p.Size=size
 p.CFrame=cf
 p.Color=color
 p.Material=Enum.Material.Metal
 p.Anchored=anchored
 p.CanCollide=canCollide
 p.CanQuery=canCollide
 p.CanTouch=canCollide
 p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local chassis=makePart("Chassis",Vector3.new(2.2,.65,4.6),rootCF,Color3.fromRGB(64,67,60),false,true,model)
chassis.RootPriority=127
chassis.CustomPhysicalProperties=PhysicalProperties.new(2,0.7,0.15,100,100)
model.PrimaryPart=chassis
local seat=Instance.new("VehicleSeat")
seat.Name="DriveSeat"
seat.Size=Vector3.new(1.65,.45,1.50)
seat.CFrame=rootCF*CFrame.new(0,1.20,.55)
seat.Anchored=false
seat.CanCollide=true
seat.Color=Color3.fromRGB(45,44,43)
seat.Parent=model
local seatWeld=Instance.new("WeldConstraint")
seatWeld.Part0=chassis
seatWeld.Part1=seat
seatWeld.Parent=seat
local visualPlaceholder=Instance.new("Folder")
visualPlaceholder.Name="PlaceholderVisuals"
visualPlaceholder.Parent=model
local function cosmetic(name,size,pos,color)
 local p=makePart(name,size,rootCF*CFrame.new(pos),color,false,false,visualPlaceholder)
 p.Massless=true
 local w=Instance.new("WeldConstraint")
 w.Part0=chassis
 w.Part1=p
 w.Parent=p
end
cosmetic("RustyFenderLeft",Vector3.new(.8,.18,4.9),Vector3.new(-1.0,.6,0),Color3.fromRGB(154,91,65))
cosmetic("RustyFenderRight",Vector3.new(.8,.18,4.9),Vector3.new(1.0,.6,0),Color3.fromRGB(154,91,65))
cosmetic("FuelTank",Vector3.new(1,.5,1.3),Vector3.new(0,.55,-.65),Color3.fromRGB(81,98,69))
cosmetic("Handlebars",Vector3.new(2.2,.2,.2),Vector3.new(0,1.72,-1.4),Color3.fromRGB(37,38,35))
local wheels=Instance.new("Folder")
wheels.Name="Wheels"
wheels.Parent=model
for _,entry in ipairs({
 {"FL",-1.65,-2.05},{"FR",1.65,-2.05},{"RL",-1.65,2.05},{"RR",1.65,2.05}
}) do
 local id,x,z=entry[1],entry[2],entry[3]
 local group=Instance.new("Model")
 group.Name="Wheel_"..id
 group.Parent=wheels
 local center=rootCF*CFrame.new(x,-.65,z)
 local root=makePart("WheelPivot",Vector3.new(.1,.1,.1),center,Color3.new(0,0,0),true,false,group)
 root.Transparency=1
 group.PrimaryPart=root
 local tire=makePart("PlaceholderTire",Vector3.new(1.938,.80,1.938),center*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(33,33,31),true,false,group)
 tire.Shape=Enum.PartType.Cylinder
 tire.Material=Enum.Material.Rubber
end
local function install(parent,name,cls,source)
 local o=Instance.new(cls)
 o.Name=name
 o.Source=source
 o.Parent=parent
end
install(model,"Config","ModuleScript","--!strict\n-- Geometry measured from ATV_Package.zip / ATV_Manifest.json, 2026-11-05.\n-- Blender: X lateral, -Y forward, Z up. Roblox: X lateral, -Z forward, Y up.\n-- Coordinates below are *relative to physical chassis center* at Blender Z=1.65.\nreturn {\n Version = \"0.3.0\",\n AssetLength = 6.1068,\n AssetWidth = 4.1002,\n AssetHeight = 3.6186,\n AssetBoundingCenterHeight = 1.8407,\n PhysicsChassisOriginHeight = 1.65,\n WheelOrder = {\"FL\", \"FR\", \"RL\", \"RR\"},\n WheelCenters = {\n  FL = Vector3.new(-1.65, -0.65, -2.05),\n  FR = Vector3.new(1.65, -0.65, -2.05),\n  RL = Vector3.new(-1.65, -0.65, 2.05),\n  RR = Vector3.new(1.65, -0.65, 2.05),\n },\n -- Mounts at the Blender shock upper attachment Z=2.12\n WheelMounts = {\n  FL = Vector3.new(-1.65, 0.47, -2.05),\n  FR = Vector3.new(1.65, 0.47, -2.05),\n  RL = Vector3.new(-1.65, 0.47, 2.05),\n  RR = Vector3.new(1.65, 0.47, 2.05),\n },\n WheelRadius = 0.969,\n WheelWidth = 0.80,\n NominalHubTravel = 1.12,\n SuspensionRestLength = 1.35,\n SuspensionMinLength = 0.42,\n SuspensionMaxLength = 1.75,\n SuspensionSagFraction = 0.17,\n SuspensionDampingRatio = 0.82,\n SuspensionMaxLoadMultiplier = 4.0,\n DriveMode = \"AWD\",\n MaxForwardSpeed = 83,\n MaxReverseSpeed = 26,\n FullPowerUntilSpeed = 47,\n DriveAcceleration = 38,\n BrakeAcceleration = 95,\n OpposingBrakeThreshold = 3,\n CoastingDrag = 0.65,\n ThrottleResponse = 5,\n SteeringAngleDegrees = 28,\n SteeringSpeedReduction = 0.64,\n SteeringResponse = 8,\n LateralResponse = 7.0,\n IdleRPM = 950,\n RedlineRPM = 7500,\n TireGrip = 1.24,\n MaterialGrip = {\n  [Enum.Material.Asphalt] = 1.25,\n  [Enum.Material.Concrete] = 1.20,\n  [Enum.Material.Grass] = 0.95,\n  [Enum.Material.Ground] = 0.88,\n  [Enum.Material.Mud] = 0.67,\n  [Enum.Material.Sand] = 0.63,\n  [Enum.Material.Snow] = 0.50,\n  [Enum.Material.Ice] = 0.18,\n },\n -- Chassis-relative coordinates measured from the exported Blender manifest.\n SuspensionPivots = {\n  FL = {upper=Vector3.new(-0.52,-0.27,-2.05), lower=Vector3.new(-0.62,-0.78,-2.05), shockUpper=Vector3.new(-0.58,0.47,-2.00), shockLower=Vector3.new(-1.11,-0.73,-2.035)},\n  FR = {upper=Vector3.new(0.52,-0.27,-2.05), lower=Vector3.new(0.62,-0.78,-2.05), shockUpper=Vector3.new(0.58,0.47,-2.00), shockLower=Vector3.new(1.11,-0.73,-2.035)},\n  RL = {upper=Vector3.new(-0.52,-0.27,2.05), lower=Vector3.new(-0.62,-0.78,2.05), shockUpper=Vector3.new(-0.58,0.47,2.10), shockLower=Vector3.new(-1.11,-0.73,2.065)},\n  RR = {upper=Vector3.new(0.52,-0.27,2.05), lower=Vector3.new(0.62,-0.78,2.05), shockUpper=Vector3.new(0.58,0.47,2.10), shockLower=Vector3.new(1.11,-0.73,2.065)},\n },\n SteeringPivot = Vector3.new(0,-0.10,-1.70),\n}\n")
install(model,"Engine","ModuleScript","-- Drivetrain input model. This is a continuous-ratio ATV approximation,\n-- not an experimentally validated engine/gearbox simulation.\nlocal Engine = {}\n\nfunction Engine.smooth(current, target, dt, response)\n\tlocal a = 1 - math.exp(-math.max(0, response) * math.clamp(dt, 0, 0.2))\n\treturn current + (math.clamp(target, -1, 1) - current) * a\nend\n\nfunction Engine.forces(throttle, forwardSpeed, mass, cfg)\n\t-- All outputs are TOTAL vehicle forces, split across tires by TirePhysics.\n\tif math.abs(throttle) < 0.035 then\n\t\treturn 0, -forwardSpeed * mass * cfg.CoastingDrag, false\n\tend\n\tif forwardSpeed * throttle < -cfg.OpposingBrakeThreshold then\n\t\treturn 0, -math.sign(forwardSpeed) * mass * cfg.BrakeAcceleration, true\n\tend\n\tlocal speedInDirection = forwardSpeed * math.sign(throttle)\n\tlocal cap = throttle >= 0 and cfg.MaxForwardSpeed or cfg.MaxReverseSpeed\n\tif speedInDirection >= cap then\n\t\treturn 0, -forwardSpeed * mass * cfg.CoastingDrag, false\n\tend\n\tlocal reduction = math.clamp((cap - speedInDirection) / math.max(cap - cfg.FullPowerUntilSpeed, 1), 0, 1)\n\t-- Reverse receives less acceleration for controlled low-speed maneuvering.\n\tlocal reverseScale = throttle < 0 and 0.65 or 1\n\treturn throttle * mass * cfg.DriveAcceleration * reduction * reverseScale, 0, false\nend\n\nfunction Engine.telemetry(throttle, speed, cfg)\n\tlocal ratio = math.clamp(math.abs(speed) / cfg.MaxForwardSpeed, 0, 1)\n\tlocal throttleRatio = math.abs(throttle) * 0.38\n\tlocal rpm = math.floor(cfg.IdleRPM + (cfg.RedlineRPM - cfg.IdleRPM) * math.max(ratio, throttleRatio))\n\tlocal gear = \"N\"\n\tif throttle > 0.08 then gear = \"D\" elseif throttle < -0.08 then gear = \"R\" end\n\treturn rpm, gear\nend\n\nreturn Engine\n")
install(model,"Steering","ModuleScript","-- Tire steering targets, in degrees. No physics-hinge steering required:\n-- forces are calculated using each front wheel's steered ground plane.\nlocal Steering = {}\n\nfunction Steering.target(input, speed, cfg)\n\tlocal v = math.clamp(math.abs(speed) / math.max(cfg.MaxForwardSpeed, 1), 0, 1)\n\tlocal factor = 1 - cfg.SteeringSpeedReduction * v\n\treturn math.clamp(input, -1, 1) * cfg.SteeringAngleDegrees * factor\nend\n\nfunction Steering.step(current, target, dt, cfg)\n\treturn current + (target - current) * (1 - math.exp(-cfg.SteeringResponse * math.clamp(dt, 0, 0.2)))\nend\n\nreturn Steering\n")
install(model,"Suspension","ModuleScript","-- Physically applied wheel loads from four independent spring-damper raycasts.\nlocal Suspension = {}\n\nfunction Suspension.sample(chassis, localMount, params, cfg, assemblyMass)\n\tlocal frame = chassis.CFrame\n\tlocal up = frame.UpVector\n\tlocal mount = frame:PointToWorldSpace(localMount)\n\tlocal distance = cfg.SuspensionMaxLength + cfg.WheelRadius\n\tlocal hit = workspace:Raycast(mount, -up * distance, params)\n\tlocal fallbackCenter = mount - up * cfg.SuspensionRestLength\n\tif not hit or hit.Normal:Dot(up) < 0.28 then\n\t\treturn {\n\t\t\tgrounded = false, center = fallbackCenter, contact = nil,\n\t\t\tnormal = up, load = 0, springForce = Vector3.zero,\n\t\t\tmaterial = nil, length = cfg.SuspensionRestLength\n\t\t}\n\tend\n\tlocal length = math.clamp(hit.Distance - cfg.WheelRadius, cfg.SuspensionMinLength, cfg.SuspensionMaxLength)\n\tlocal compression = math.max(0, cfg.SuspensionRestLength - length)\n\tlocal mPerWheel = math.max(1, assemblyMass / 4)\n\tlocal k = mPerWheel * workspace.Gravity / math.max(cfg.SuspensionRestLength * cfg.SuspensionSagFraction, 0.1)\n\tlocal damping = 2 * math.sqrt(k * mPerWheel) * cfg.SuspensionDampingRatio\n\tlocal pointVelocity = chassis:GetVelocityAtPosition(mount)\n\tlocal verticalSpeed = pointVelocity:Dot(up)\n\tlocal maxLoad = mPerWheel * workspace.Gravity * cfg.SuspensionMaxLoadMultiplier\n\tlocal load = math.clamp(k * compression - damping * verticalSpeed, 0, maxLoad)\n\treturn {\n\t\tgrounded = true, center = hit.Position + up * cfg.WheelRadius,\n\t\tcontact = hit.Position, normal = hit.Normal, load = load,\n\t\tspringForce = up * load, material = hit.Material, length = length\n\t}\nend\n\nreturn Suspension\n")
install(model,"Tires","ModuleScript","-- Forces applied at the contact patch to produce turning, acceleration,\n-- braking and slip. Includes a traction-circle clamp for each tire.\nlocal Tires = {}\n\nlocal function planar(v, normal)\n\tlocal p = v - normal * v:Dot(normal)\n\tif p.Magnitude < 0.001 then return nil end\n\treturn p.Unit\nend\n\nfunction Tires.compute(chassis, contact, surfaceNormal, normalLoad, material, steerDegrees,\n\tpropulsionTotal, resistTotal, assemblyMass, drivenCount, isDriven, cfg)\n\tif normalLoad <= 0 then return Vector3.zero, 0 end\n\tlocal up = chassis.CFrame.UpVector\n\tlocal yaw = CFrame.fromAxisAngle(up, math.rad(steerDegrees))\n\tlocal nominalForward = yaw:VectorToWorldSpace(chassis.CFrame.LookVector)\n\tlocal forward = planar(nominalForward, surfaceNormal)\n\tif not forward then return Vector3.zero, 0 end\n\tlocal right = forward:Cross(surfaceNormal).Unit\n\tlocal velocity = chassis:GetVelocityAtPosition(contact)\n\tlocal longSpeed = velocity:Dot(forward)\n\tlocal lateralSpeed = velocity:Dot(right)\n\tlocal drive = isDriven and propulsionTotal / math.max(1, drivenCount) or 0\n\tlocal braking = resistTotal / 4\n\tlocal lateral = -lateralSpeed * (assemblyMass / 4) * cfg.LateralResponse\n\tlocal wanted = forward * (drive + braking) + right * lateral\n\tlocal materialGrip = cfg.MaterialGrip[material] or 0.88\n\tlocal tractionCap = normalLoad * cfg.TireGrip * materialGrip\n\tif wanted.Magnitude > tractionCap and wanted.Magnitude > 0 then\n\t\twanted = wanted.Unit * tractionCap\n\tend\n\treturn wanted, longSpeed\nend\n\nreturn Tires\n")
install(model,"VisualRig","ModuleScript","-- Imported-mesh visual posing for the Blender ATV. Cosmetic only;\n-- physics and traction remain entirely inside server raycasts/forces.\nlocal Rig = {}\nlocal function rotatedAround(pivot, rotation)\n return CFrame.new(pivot) * rotation * CFrame.new(-pivot)\nend\nlocal function swingBetween(a, b)\n local oldDir = a.Unit\n local newDir = b.Unit\n local cross = oldDir:Cross(newDir)\n local dot = math.clamp(oldDir:Dot(newDir), -1, 1)\n if cross.Magnitude < 0.00001 then return CFrame.new() end\n return CFrame.fromAxisAngle(cross.Unit, math.acos(dot))\nend\nfunction Rig.create(folder, cfg)\n local entries = {}\n if not folder then return entries end\n for _, item in ipairs(folder:GetDescendants()) do\n  if item:IsA(\"BasePart\") then\n   local kind = item:GetAttribute(\"ATVKind\")\n   local corner = item:GetAttribute(\"ATVCorner\")\n   local rest = item:GetAttribute(\"ATVRestLocal\")\n   if type(kind) == \"string\" and typeof(rest) == \"CFrame\" then\n    table.insert(entries, {part=item, kind=kind, corner=corner, rest=rest})\n   end\n  end\n end\n return entries\nend\nfunction Rig.step(entries, chassisCF, wheelTravel, steerAngle, cfg)\n for _, entry in ipairs(entries) do\n  local kind = entry.kind\n  local id = entry.corner\n  local delta = (type(id) == \"string\" and wheelTravel[id]) or 0\n  local offset = CFrame.new()\n  local settings = type(id) == \"string\" and cfg.SuspensionPivots[id] or nil\n  if kind == \"UpperArm\" or kind == \"LowerArm\" then\n   if settings then\n    local p = kind == \"UpperArm\" and settings.upper or settings.lower\n    local side = string.sub(id, 2, 2) == \"R\" and 1 or -1\n    local armReach = kind == \"UpperArm\" and 0.72 or 0.68\n    local angle = math.atan2(delta, armReach) * side\n    offset = rotatedAround(p, CFrame.Angles(0,0,angle))\n   end\n  elseif kind == \"Knuckle\" then\n   local yaw = string.sub(id,1,1)==\"F\" and math.rad(steerAngle) or 0\n   local center = cfg.WheelCenters[id]\n   offset = CFrame.new(0,delta,0) * rotatedAround(center, CFrame.Angles(0,yaw,0))\n  elseif kind == \"Shock\" then\n   if settings then\n    local top = settings.shockUpper\n    local restVec = settings.shockLower - top\n    local newVec = restVec + Vector3.new(0, delta, 0)\n    offset = rotatedAround(top, swingBetween(restVec, newVec))\n    -- Spring/rod length is still a fixed mesh. Mesh deformation needs rigging.\n    if string.find(entry.part.Name, \"Piston\") or string.find(entry.part.Name, \"LowerBracket\") then\n     offset = CFrame.new(0,delta*0.75,0) * offset\n    end\n   end\n  elseif kind == \"Handlebar\" then\n   offset = rotatedAround(cfg.SteeringPivot, CFrame.Angles(0, math.rad(steerAngle)*0.65,0))\n  elseif kind == \"TieRod\" then\n   offset = CFrame.new(0,delta*0.5,0)\n  end\n  if entry.part.Parent then\n   entry.part.CFrame = chassisCF * offset * entry.rest\n  end\n end\nend\nreturn Rig\n")
install(model,"VehicleController","Script","-- Server-authoritative raycast ATV, matched to ATV_Manifest.json.\n-- The imported 165-part visual geometry is installed by ImportBlenderATV command.\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal vehicle = script.Parent\nlocal cfg = require(vehicle:WaitForChild(\"Config\"))\nlocal Engine = require(vehicle:WaitForChild(\"Engine\"))\nlocal Steering = require(vehicle:WaitForChild(\"Steering\"))\nlocal Suspension = require(vehicle:WaitForChild(\"Suspension\"))\nlocal Tires = require(vehicle:WaitForChild(\"Tires\"))\nlocal VisualRig = require(vehicle:WaitForChild(\"VisualRig\"))\nlocal seat = vehicle:WaitForChild(\"DriveSeat\")\nlocal chassis = vehicle:WaitForChild(\"Chassis\")\nlocal visuals = vehicle:WaitForChild(\"Wheels\")\nlocal params = RaycastParams.new()\nparams.FilterType = Enum.RaycastFilterType.Exclude\nparams.FilterDescendantsInstances = {vehicle}\nparams.RespectCanCollide = true\nlocal throttle, steeringAngle = 0, 0\nlocal spin = {FL = 0, FR = 0, RL = 0, RR = 0}\nlocal wheelState = {}\nlocal rig = VisualRig.create(vehicle:FindFirstChild(\"VisualDetails\"), cfg)\nlocal function buildWheelForce(id)\n local attachment = Instance.new(\"Attachment\")\n attachment.Name = \"ForcePoint_\" .. id\n attachment.Position = cfg.WheelMounts[id]\n attachment.Parent = chassis\n local force = Instance.new(\"VectorForce\")\n force.Name = \"ContactForce_\" .. id\n force.Attachment0 = attachment\n force.RelativeTo = Enum.ActuatorRelativeTo.World\n force.ApplyAtCenterOfMass = false\n force.Parent = chassis\n return {attachment = attachment, force = force}\nend\nfor _, id in ipairs(cfg.WheelOrder) do wheelState[id] = buildWheelForce(id) end\nlocal wheelTravel = {}\n-- Recreate visual-cache if the Blender importer runs while the game is stopped\n-- (regular edit-mode workflow initializes it correctly at Play time).\npcall(function() chassis:SetNetworkOwner(nil) end)\nRunService.Heartbeat:Connect(function(dt)\n dt = math.clamp(dt, 1/240, 0.1)\n local humanoid = seat.Occupant\n local driver = humanoid and Players:GetPlayerFromCharacter(humanoid.Parent)\n local t = driver and seat.ThrottleFloat or 0\n local s = driver and seat.SteerFloat or 0\n throttle = Engine.smooth(throttle, t, dt, cfg.ThrottleResponse)\n local forwardSpeed = chassis.AssemblyLinearVelocity:Dot(chassis.CFrame.LookVector)\n steeringAngle = Steering.step(steeringAngle, Steering.target(s, forwardSpeed, cfg), dt, cfg)\n local mass = chassis.AssemblyMass\n local driveForce, resistForce, braking = Engine.forces(throttle, forwardSpeed, mass, cfg)\n local drivenCount = cfg.DriveMode==\"AWD\" and 4 or 2\n local grounded = 0\n for _, id in ipairs(cfg.WheelOrder) do\n  local wheel = wheelState[id]\n  local state = Suspension.sample(chassis, cfg.WheelMounts[id], params, cfg, mass)\n  local steer = string.sub(id,1,1)==\"F\" and steeringAngle or 0\n  local tireForce = Vector3.zero\n  local groundSpeed = forwardSpeed\n  if state.grounded then\n   grounded += 1\n   local powered = cfg.DriveMode==\"AWD\" or string.sub(id,1,1)==\"R\"\n   tireForce, groundSpeed = Tires.compute(chassis, state.contact, state.normal,\n    state.load, state.material, steer, driveForce, resistForce, mass, drivenCount, powered, cfg)\n  end\n  wheel.attachment.Position = chassis.CFrame:PointToObjectSpace(state.contact or state.center)\n  wheel.force.Force = state.springForce + tireForce\n  -- Angle zero at the wheel's *Blender axle-X* rest pose. The imported\n  -- visual group includes a nonvisible center pivot at that axis.\n  spin[id] += groundSpeed / math.max(cfg.WheelRadius, 0.1) * dt\n  local wheelVisual = visuals:FindFirstChild(\"Wheel_\" .. id)\n  if wheelVisual then\n   local frame = CFrame.new(state.center) * chassis.CFrame.Rotation\n    * CFrame.Angles(0,math.rad(steer),0) * CFrame.Angles(spin[id],0,0)\n   if wheelVisual:IsA(\"Model\") then wheelVisual:PivotTo(frame)\n   elseif wheelVisual:IsA(\"BasePart\") then wheelVisual.CFrame = frame * CFrame.Angles(0,0,math.pi/2) end\n  end\n  wheelTravel[id] = math.clamp(cfg.NominalHubTravel - state.length, -0.7, 0.7)\n end\n VisualRig.step(rig, chassis.CFrame, wheelTravel, steeringAngle, cfg)\n local rpm, gear = Engine.telemetry(throttle, forwardSpeed, cfg)\n vehicle:SetAttribute(\"Speed\", math.abs(forwardSpeed))\n vehicle:SetAttribute(\"RPM\", rpm)\n vehicle:SetAttribute(\"Gear\", gear)\n vehicle:SetAttribute(\"GroundedWheels\", grounded)\n vehicle:SetAttribute(\"SteeringAngle\", steeringAngle)\n vehicle:SetAttribute(\"Braking\", braking)\n vehicle:SetAttribute(\"DriveMode\", cfg.DriveMode)\nend)\n")
local prior=StarterPlayer.StarterPlayerScripts:FindFirstChild("ATVClient")
if prior then prior:Destroy() end
install(StarterPlayer:WaitForChild("StarterPlayerScripts"),"ATVClient","LocalScript","-- Client-only telemetry overlay: no client control of physics or vehicle forces.\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"ATVTelemetry\"\ngui.ResetOnSpawn = false\ngui.IgnoreGuiInset = true\ngui.Parent = player:WaitForChild(\"PlayerGui\")\nlocal container = Instance.new(\"Frame\")\ncontainer.Size = UDim2.fromOffset(244, 120)\ncontainer.Position = UDim2.new(1, -260, 1, -138)\ncontainer.BackgroundColor3 = Color3.fromRGB(18, 20, 22)\ncontainer.BackgroundTransparency = 0.11\ncontainer.BorderSizePixel = 0\ncontainer.Visible = false\ncontainer.Parent = gui\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 12)\ncorner.Parent = container\nlocal stroke = Instance.new(\"UIStroke\")\nstroke.Color = Color3.fromRGB(87, 92, 95)\nstroke.Thickness = 1\nstroke.Transparency = 0.4\nstroke.Parent = container\nlocal function label(y, h, size, color)\n\tlocal l = Instance.new(\"TextLabel\")\n\tl.Size = UDim2.new(1, -24, 0, h)\n\tl.Position = UDim2.fromOffset(12, y)\n\tl.BackgroundTransparency = 1\n\tl.TextXAlignment = Enum.TextXAlignment.Left\n\tl.TextColor3 = color\n\tl.Font = Enum.Font.GothamBold\n\tl.TextSize = size\n\tl.Parent = container\n\treturn l\nend\nlocal speed = label(8, 44, 30, Color3.fromRGB(247, 249, 250))\nlocal rev = label(55, 24, 16, Color3.fromRGB(224, 150, 93))\nlocal status = label(86, 21, 13, Color3.fromRGB(174, 180, 185))\nRunService.RenderStepped:Connect(function()\n\tlocal char = player.Character\n\tlocal humanoid = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tlocal occupied = humanoid and humanoid.SeatPart\n\tlocal model = occupied and occupied.Parent\n\tif occupied and occupied.Name == \"DriveSeat\" and model and model:GetAttribute(\"RPM\") ~= nil then\n\t\tcontainer.Visible = true\n\t\tlocal kph = math.abs(model:GetAttribute(\"Speed\") or 0) * 1.008\n\t\tspeed.Text = string.format(\"%03d km/h\", math.floor(kph + 0.5))\n\t\trev.Text = string.format(\"%s  •  %d RPM\", model:GetAttribute(\"Gear\") or \"N\", model:GetAttribute(\"RPM\") or 0)\n\t\tstatus.Text = string.format(\"%s  •  %d/4 wheels grounded\", model:GetAttribute(\"DriveMode\") or \"AWD\", model:GetAttribute(\"GroundedWheels\") or 0)\n\telse\n\t\tcontainer.Visible = false\n\tend\nend)\n")
print("ZuzuATV v0.3 prototype ready. Import RoPilot ATV.fbx as Workspace.ATV, then run ImportBlenderATV.server.luau. For placeholder test press Play and sit.")
